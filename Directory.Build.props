<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: public XML docs are encouraged, not required. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Overridden by CI from the git tag (vX.Y.Z → X.Y.Z). -->
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
    <Authors>Farming RPG Maker contributors</Authors>
    <Product>Farming RPG Maker</Product>
  </PropertyGroup>
</Project>

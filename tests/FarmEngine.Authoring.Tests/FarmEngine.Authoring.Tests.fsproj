<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- With nullness checking on, some F# 10 compilers (SDK 10.0.112, for one) take minutes per
         file on these tests, so `dotnet build` looks hung. The library keeps it on. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestProjects.fs" />
    <Compile Include="DocumentTests.fs" />
    <Compile Include="SceneEditTests.fs" />
    <Compile Include="ContentEditTests.fs" />
    <Compile Include="ProjectEditTests.fs" />
    <Compile Include="DefaultsTests.fs" />
    <Compile Include="ProblemsTests.fs" />
    <Compile Include="PatternsTests.fs" />
    <Compile Include="PropertyTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FarmEngine.Authoring/FarmEngine.Authoring.fsproj" />
    <ProjectReference Include="../../src/FarmEngine.Content/FarmEngine.Content.csproj" />
    <ProjectReference Include="../../src/FarmEngine.Core/FarmEngine.Core.csproj" />
    <ProjectReference Include="../../src/FarmEngine.Schemas/FarmEngine.Schemas.csproj" />
  </ItemGroup>
</Project>

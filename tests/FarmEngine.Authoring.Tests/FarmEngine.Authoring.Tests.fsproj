<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- With nullness checking on, some F# 10 compilers (SDK 10.0.112, for one) take minutes per
         file on these tests, so `dotnet build` looks hung. The library keeps it on. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestProjects.fs" />
    <Compile Include="JsonTests.fs" />
    <Compile Include="SchemaRecordTests.fs" />
    <Compile Include="MigrationTests.fs" />
    <Compile Include="DocumentTests.fs" />
    <Compile Include="SceneEditTests.fs" />
    <Compile Include="ContentEditTests.fs" />
    <Compile Include="ProjectEditTests.fs" />
    <Compile Include="PackMergeTests.fs" />
    <Compile Include="PackRulesTests.fs" />
    <Compile Include="ContentCompilerTests.fs" />
    <Compile Include="ProjectCatalogTests.fs" />
    <Compile Include="DefaultsTests.fs" />
    <Compile Include="ProblemsTests.fs" />
    <Compile Include="ReferencesTests.fs" />
    <Compile Include="PatternsTests.fs" />
    <Compile Include="PropertyTests.fs" />
    <Compile Include="BrokenProjects.fs" />
    <Compile Include="ValidationCaseTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="CartridgeTests.fs" />
    <Compile Include="SnapshotTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../fixtures/golden/migrations/*.json" Link="Golden/migrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/projects/migrated/*.json" Link="Migrated/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/golden/content/*.json" Link="Golden/content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/golden/cartridges/*.cart" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/golden/replays/*.json" Link="Golden/replays/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/projects/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/authoring/*.json" Link="Snapshots/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FarmEngine.Authoring/FarmEngine.Authoring.fsproj" />
    <ProjectReference Include="../../src/FarmEngine.Authoring.Net/FarmEngine.Authoring.Net.fsproj" />
  </ItemGroup>
</Project>

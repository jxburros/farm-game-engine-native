<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FarmEngine.Rendering</RootNamespace>
    <Description>2D world renderer on SkiaSharp — port of packages/renderer-canvas2d.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FarmEngine.Core/FarmEngine.Core.csproj" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <!-- The built-in pixel-art pack (generated by tools/art/build_art.py; committed, so
         building never needs Python or Blender). Resource names: builtin/<file>. -->
    <EmbeddedResource Include="Assets/builtin/*.png;Assets/builtin/manifest.json" LogicalName="builtin/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

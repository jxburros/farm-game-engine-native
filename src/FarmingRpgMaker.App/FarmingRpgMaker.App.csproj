<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FarmingRpgMaker.App</RootNamespace>
    <!-- The executable is FarmingRpgMaker.exe (the Velopack mainExe). -->
    <AssemblyName>FarmingRpgMaker</AssemblyName>
    <Description>Farming RPG Maker desktop app (Avalonia).</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Self-contained publishes contain the full framework, untrimmed: the app (System.Text.Json
         serialization, F# printf and reflection) has never been checked for trimming warnings,
         and Velopack's delta packages keep updates small anyway. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- farm_ffi (the Rust engine, renderer and player) is built from crates inside farm-player's
         dependency graph, so the player's notices cover it (tools/player-licenses). -->
    <None Include="../../tools/player-licenses/THIRD-PARTY.txt" Link="licenses/THIRD-PARTY-rust.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The NuGet packages, the .NET runtime, the icons and Inter (tools/editor-licenses), and the
         app's own license. -->
    <None Include="../../tools/editor-licenses/THIRD-PARTY-dotnet.txt" Link="licenses/THIRD-PARTY-dotnet.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="licenses/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Help → Creator Guide renders the guide from the repository's docs (Views/HelpWindows.cs). -->
    <EmbeddedResource Include="../../docs/CREATOR-GUIDE.md" LogicalName="FarmingRpgMaker.App.CreatorGuide.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FarmingRpgMaker.Updates/FarmingRpgMaker.Updates.csproj" />
    <ProjectReference Include="../FarmEngine.Authoring/FarmEngine.Authoring.fsproj" />
    <ProjectReference Include="../FarmEngine.Authoring.Net/FarmEngine.Authoring.Net.fsproj" />
    <ProjectReference Include="../FarmEngine.Export/FarmEngine.Export.fsproj" />
    <ProjectReference Include="../FarmEngine.Interop/FarmEngine.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FarmingRpgMaker.App.Tests" />
  </ItemGroup>
</Project>

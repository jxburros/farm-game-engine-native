<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="using:FarmingRpgMaker.App.Game">

  <!-- Play-mode HUD bar (web: bg-card border rounded-lg p-3 shadow-sm) -->
  <Style Selector="Border.hud">
    <Setter Property="Background" Value="{StaticResource FarmCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
  </Style>
  <Style Selector="TextBlock.hud-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hud-value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hud-value.primary">
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.hud-value.secondary">
    <Setter Property="Foreground" Value="#B45F12" />
  </Style>
  <Style Selector="Border.money-chip">
    <Setter Property="Background" Value="{StaticResource FarmAccentBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,3" />
  </Style>
  <Style Selector="Border.money-chip TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
  </Style>
  <Style Selector="ProgressBar.energy">
    <Setter Property="Width" Value="110" />
    <Setter Property="Height" Value="10" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ProgressBar.energy.low">
    <Setter Property="Foreground" Value="{StaticResource FarmDestructiveBrush}" />
  </Style>

  <!-- Small outline toolbar buttons (web: variant="outline" size="sm") -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.swatch:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D5EBDC" />
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FarmSuccessTintBrush}" />
    <Setter Property="BorderBrush" Value="#9CC9A9" />
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Button.option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FCEFB8" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmAccentBrush}" />
  </Style>

  <!-- Game frame around the canvas (web: bg-muted/30 border-2 border-border rounded-xl shadow-lg) -->
  <Style Selector="Border.game-frame">
    <Setter Property="Background" Value="#4DE4DDCF" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #22000000" />
  </Style>
  <Style Selector="Border.controls-help">
    <Setter Property="Background" Value="#80E4DDCF" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Border.key">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="20" />
  </Style>
  <Style Selector="Border.key TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Modals (web: fixed inset-0 bg-background/80 + Card) -->
  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="#99F8F5EE" />
  </Style>
  <Style Selector="Border.modal">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 12 32 0 #33000000" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="24" />
  </Style>
  <Style Selector="Border.modal-header">
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.modal-footer">
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="#4DE4DDCF" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0,0,12,12" />
  </Style>
  <Style Selector="Border.icon-tile">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#1A095C34" />
  </Style>
  <Style Selector="Border.icon-tile PathIcon">
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Background" Value="#80F0EBE0" />
    <Setter Property="BorderBrush" Value="#80D4CDBF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.category">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource FarmDestructiveBrush}" />
  </Style>
  <Style Selector="Border.qty-chip">
    <Setter Property="Background" Value="#1A095C34" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.qty-chip TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>

  <!-- Dialogue box (web DialogueBox: bottom card with round portrait) -->
  <Style Selector="Border.dialogue">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #33000000" />
  </Style>
  <Style Selector="Border.portrait">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Background" Value="{StaticResource FarmSecondaryBrush}" />
    <Setter Property="BoxShadow" Value="0 2 6 0 #33000000" />
  </Style>

  <!-- Toasts (web sonner: success / error / info) -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #26000000" />
  </Style>
  <Style Selector="Border.toast.success">
    <Setter Property="Background" Value="{StaticResource FarmSuccessTintBrush}" />
    <Setter Property="BorderBrush" Value="#9CC9A9" />
  </Style>
  <Style Selector="Border.toast.error">
    <Setter Property="Background" Value="{StaticResource FarmErrorTintBrush}" />
    <Setter Property="BorderBrush" Value="#E7A19B" />
  </Style>
  <Style Selector="Border.toast PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource FarmMutedForegroundBrush}" />
  </Style>
  <Style Selector="Border.toast.success PathIcon">
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="Border.toast.error PathIcon">
    <Setter Property="Foreground" Value="{StaticResource FarmDestructiveBrush}" />
  </Style>

  <!-- Game panels (creator HUD panels) -->
  <Style Selector="Border.game-panel">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#718171" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Debug drawer -->
  <Style Selector="Border.debug">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#E8C35A" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #33000000" />
  </Style>

  <!-- Editor side panel + notice -->
  <Style Selector="Border.side-panel">
    <Setter Property="Background" Value="{StaticResource FarmCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource FarmUpdateTintBrush}" />
    <Setter Property="BorderBrush" Value="#EBC954" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.stat TextBlock.stat-value">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource FarmPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.swatch">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ToggleButton.swatch:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FarmUpdateTintBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FarmForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Project dialogs -->
  <Style Selector="ListBox.projects">
    <Setter Property="Background" Value="{StaticResource FarmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FarmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.projects ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FarmSuccessTintBrush}" />
  </Style>
  <Style Selector="ListBox.projects ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D5EBDC" />
  </Style>
  <Style Selector="ListBox.projects ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="RadioButton.template">
    <Setter Property="Padding" Value="10,8" />
  </Style>
</Styles>

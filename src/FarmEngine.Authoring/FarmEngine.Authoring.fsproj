<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FarmEngine.Authoring</RootNamespace>
    <Description>Project logic: edits, undo/redo, validation (docs/LANGUAGES.md "F#").</Description>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- FS3370: the message that suggests `xs[i]` over `xs.[i]`. Every other warning fails the
         build, as in C# (TreatWarningsAsErrors), and FS3390 checks the XML doc comments. -->
    <NoWarn>$(NoWarn);FS3370</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="JsonCodec.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="SchemaJson.fs" />
    <Compile Include="SchemaConstants.fs" />
    <Compile Include="Migrations.fs" />
    <Compile Include="AuthoringTiles.fs" />
    <Compile Include="PackRules.fs" />
    <Compile Include="Builtin.fs" />
    <Compile Include="PackMerge.fs" />
    <Compile Include="ContentCompiler.fs" />
    <Compile Include="StarterContent.fs" />
    <Compile Include="ProjectCatalog.fs" />
    <Compile Include="Edits.fs" />
    <Compile Include="Update.fs" />
    <Compile Include="Cleanup.fs" />
    <Compile Include="EditScenes.fs" />
    <Compile Include="EditContent.fs" />
    <Compile Include="EditProject.fs" />
    <Compile Include="Document.fs" />
    <Compile Include="MinigameKinds.fs" />
    <Compile Include="Defaults.fs" />
    <Compile Include="SettingsForms.fs" />
    <Compile Include="References.fs" />
    <Compile Include="Vocabulary.fs" />
    <Compile Include="Readouts.fs" />
    <Compile Include="Problem.fs" />
    <Compile Include="SchemaChecks.fs" />
    <Compile Include="ContentLints.fs" />
    <Compile Include="ChecksWorld.fs" />
    <Compile Include="ChecksContent.fs" />
    <Compile Include="ChecksExport.fs" />
    <Compile Include="Problems.fs" />
    <Compile Include="ProjectLoad.fs" />
    <Compile Include="AssetUsage.fs" />
    <Compile Include="ArtLibrary.fs" />
    <Compile Include="PackExport.fs" />
    <Compile Include="ModRegistry.fs" />
    <Compile Include="Bytes.fs" />
    <Compile Include="FlatBuffers.fs" />
    <Compile Include="CartridgeCompiler.fs" />
    <Compile Include="CartridgeReader.fs" />
    <Compile Include="Playtest.fs" />
    <Compile Include="Patterns.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="WebApi.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>

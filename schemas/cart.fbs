namespace FarmEngine.Cart;

// Fields may be appended, never reordered. cart_format changes on a breaking revision.
table GameInfo {
  title:string (required);
  version:string (required);
  game_id:string (required);
  author:string;
  company:string;
  executable_name:string;
  window_width:uint = 1280;
  window_height:uint = 800;
  fullscreen:bool = false;
  pixel_scale:string;
  credits:string;
}

// An embedded file (image, later audio), stored once and referenced from the JSON sections
// as the string "asset:<id>". Ids are content hashes, so the same bytes always get the same id.
table Asset {
  id:string (required, key);
  mime:string (required);
  data:[ubyte] (required);
}

// A sandboxed plugin of an enabled content pack, in load order. `granted_hooks` is the plugin's
// hooks that the pack manifest's permissions allow. `granted_mutations` is the manifest's
// `permissions.mutations`, absent when it declares none (the player then applies the defaults).
table Plugin {
  id:string (required);
  pack_id:string (required);
  source:string (required);
  granted_hooks:[string];
  granted_mutations:[string];
}

// Format 2. The player never reads project JSON: the compiler splits a project into the
// compiled content, the inputs of a new game (start) and what the renderer and game panels
// need (presentation). The JSON sections keep the v8 JavaScript number behaviour until the
// native-numerics cutover; `data:` URLs inside them are moved to `assets`.
table Cartridge {
  cart_format:uint;
  project_schema_version:uint;
  info:GameInfo (required);
  // Format 1 carried the whole project here.
  project_json:[ubyte] (deprecated);
  content_json:[ubyte] (required);
  start_json:[ubyte] (required);
  presentation_json:[ubyte] (required);
  // Sorted by id.
  assets:[Asset];
  plugins:[Plugin];
}

root_type Cartridge;
file_identifier "FGCT";

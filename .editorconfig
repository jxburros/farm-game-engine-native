root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,axaml,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# A guideline for editors and reviews, not enforced: some older C# lines are longer (Rust
# uses rustfmt.toml's max_width = 120). CI enforces the whitespace and style rules of
# this file with `dotnet format` (C#) and tools/ci/text-style.py (everything else).
[*.{cs,fs,fsx,fsi}]
max_line_length = 160
